# Локальный запуск: скопируйте этот файл в .env и укажите токен.
BOT_TOKEN=your_telegram_bot_token
# Telegram ID через запятую. Администратор 764620701 разрешён автоматически.
ALLOWED_USER_IDS=764620701,123456789
# Для Render Persistent Disk, например: /var/data/users.db
# DATABASE_PATH=/var/data/users.db
# Необязательно: дополнительная защита webhook.
# WEBHOOK_SECRET=your_random_webhook_secret
